LOG_LEVEL=INFO
EVENTS_SOURCE_FILE=events.csv
RUNNERS_SOURCE_FILE=runners.csv

# DATA_DIR / LOG_DIR default to ./data and ./logs for local runs.
# docker-compose.yml overrides both to /app/data and /app/logs inside the container.

# --- AWS S3 source (optional) ---
# When S3_BUCKET is set, the bronze layer reads from
# s3://S3_BUCKET/S3_EVENTS_KEY and s3://S3_BUCKET/S3_RUNNERS_KEY instead of the
# local data/raw files. Leave S3_BUCKET empty to keep using the local sample
# files (this is what tests and `docker compose run` use by default).
S3_BUCKET=
S3_EVENTS_KEY=raw/events.csv
S3_RUNNERS_KEY=raw/runners.csv
AWS_REGION=us-east-1

# Credentials: prefer an IAM role (EC2/ECS/EKS task role) or a mounted
# ~/.aws/credentials profile over static keys. Only set these for local dev
# without either of those:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=      # only if using temporary/STS credentials
# S3_ENDPOINT_URL=        # set for LocalStack/MinIO, e.g. http://localhost:4566
