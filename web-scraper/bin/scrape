#!/usr/bin/env ruby
require_relative '../lib/scraper'

Scraper::EventScraper.new.save_events

event_store = Scraper::EventStore.new(Scraper.data_path('events.csv'))
events = event_store.all.reject(&:scraped?)
Scraper::RunnerImporter.new(event_store: event_store).import(events)

Scraper.upload_to_s3!
