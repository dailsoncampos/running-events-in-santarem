require_relative 'lib/scraper'

namespace :scrape do
  desc 'Scrape and save running events from Santarém into data/events.csv'
  task :events do
    Scraper::EventScraper.new.save_events
  end

  desc 'Parse CLAX result files for events not yet scraped into data/runners.csv'
  task :runners do
    event_store = Scraper::EventStore.new(Scraper.data_path('events.csv'))
    events = event_store.all.reject(&:scraped?)

    Scraper::RunnerImporter.new(event_store: event_store).import(events)
  end

  desc 'Upload data/events.csv and data/runners.csv to S3 (no-op unless S3_BUCKET is set)'
  task :upload do
    Scraper.upload_to_s3!
  end

  desc 'Run the full scrape: events, then runners for each new event, then upload to S3'
  task all: %i[events runners upload]
end

task default: 'scrape:all'
