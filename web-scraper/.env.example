# --- AWS S3 export (optional) ---
# When S3_BUCKET is set, `rake scrape:all` (and `bin/scrape`) upload
# data/events.csv and data/runners.csv to s3://S3_BUCKET/{S3_EVENTS_KEY,S3_RUNNERS_KEY}
# after scraping. Leave S3_BUCKET empty to skip the upload entirely (this is
# what the test suite and a bare `bin/scrape` use by default, no AWS access
# required).
S3_BUCKET=
S3_EVENTS_KEY=raw/events.csv
S3_RUNNERS_KEY=raw/runners.csv
AWS_REGION=us-east-1

# Credentials: prefer an IAM role (EC2/ECS/EKS task role) or a mounted
# ~/.aws/credentials profile over static keys. Only set these for local dev
# without either of those:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=      # only if using temporary/STS credentials
# S3_ENDPOINT_URL=        # set for LocalStack/MinIO, e.g. http://localhost:4566
